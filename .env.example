# 复制本文件为 .env 后填入真实密钥：Copy-Item .env.example .env
# .env 已被 .gitignore 忽略，不会提交到仓库

# 阿里云百炼（DashScope）API Key，兼容 OpenAI 接口
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Windows 控制台默认 GBK，模型回复含特殊字符时 print 会抛 UnicodeEncodeError
# uv 不支持 [tool.uv] env 字段，改为放在这里，uv run 会自动加载项目根的 .env
PYTHONIOENCODING=utf-8
PYTHONUTF8=1
